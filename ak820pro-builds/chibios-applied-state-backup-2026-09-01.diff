+         spuriously dispatch the idle driver handler, then re-enable it. */
+      SN_SPI1->CTRL0_b.FRESET = 0b11;
+      SN_SPI1->IC = 0x3F;
+      nvicClearPending(SN32_SPI1_NUMBER);
+      nvicEnableVector(SN32_SPI1_NUMBER, SN32_SPI_SPI1_IRQ_PRIORITY);
