+  sn32_flash_dma_config();
+  SN_SPI0->CTRL0_b.FRESET = 0b11;
+  SN_SPI0->DMACTRL_b.DMAEN = 0;
+  SN_SPI0->DMACTRL_b.DIR   = 0;              /* SPI1(flash) -> SPI0(LCD) */
+  SN_SPI0->DMACNT_b.CNT    = len - 1;
+  SN_SPI0->DMAHTCNT_b.HTCNT = (len - 1) / 2;
