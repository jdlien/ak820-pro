 }
 
+/* The lock-LED channel's lease (plans/LOCK-LED-CHANNEL-PLAN.md, R3-2): when
+ * raw HID last carried an accepted media command, by USB or through the 2.4G
+ * dongle (raw81 dispatches here too). Set here at the ingress, never in the
+ * display's setters, which the lock-LED handler calls as well. */
+static uint32_t rawhid_media_at;
+static bool     rawhid_media_seen;
+
+bool hid_rawhid_media_within(uint32_t now, uint32_t ms) {
+    return rawhid_media_seen && now - rawhid_media_at < ms;
+}
+
+static void text_command_inner(uint8_t *data, uint8_t length);
+
 static void text_command(uint8_t *data, uint8_t length) {
+    text_command_inner(data, length);
+    if (data[0] != RTC_UNHANDLED) {
+        rawhid_media_at   = timer_read32();
+        rawhid_media_seen = true;
+    }
+}
+
+static void text_command_inner(uint8_t *data, uint8_t length) {
     switch (data[2]) {
         case TEXT_SET:
             /* data[3] = icon id, data[4..] = ASCII. Length is whatever the host
@@ -1115,12 +1136,22 @@ static void health_command(uint8_t *data, uint8_t length) {
                     if (length < 32 || !ch582_rxtap_page(data[4], &data[4])) data[0] = RTC_UNHANDLED;
                     break;
                 case 17: {
-                    if (length < 32 || data[4] > 5 || (data[4] == 4 && (data[5] == 0 || data[5] > 50)) ||
+                    if (length < 32 || (data[4] > 5 && data[4] != 7) || (data[4] == 4 && (data[5] == 0 || data[5] > 50)) ||
                         (data[4] == 5 && data[5] > 2)) {
                         data[0] = RTC_UNHANDLED;
                         break;
                     }
                     uint8_t sub = data[4];
+                    if (sub == 7) {
+                        /* The lock-LED handler: [5..8] applied, [9..12]
+                         * rejected, [13..16] refused by the lease (u32 LE). */
+                        uint32_t c[3];
+                        ch582_lockchan_media_counts(c);
+                        memset(&data[4], 0, 28);
+                        data[4] = 7;
+                        memcpy(&data[5], c, sizeof c);
+                        break;
+                    }
                     if (sub == 5) {
                         /* Responses held in the pump: [5] 1 on, 2 off, 0
                          * reads. Reply: 5, the state. */
diff --git a/keyboards/a_jazz/ak820pro/lockchan_media.c b/keyboards/a_jazz/ak820pro/lockchan_media.c
new file mode 100644
index 00000000..05a64287
--- /dev/null
+++ b/keyboards/a_jazz/ak820pro/lockchan_media.c
@@ -0,0 +1,35 @@
+// Copyright 2026 JD Lien
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "lockchan_media.h"
+
+static bool printable(const uint8_t *s, uint8_t n) {
+    for (uint8_t i = 0; i < n; i++) {
+        if (s[i] < 0x20 || s[i] > 0x7E) return false;
+    }
+    return true;
+}
+
+bool lockchan_media_parse(const lockchan_frame_t *f, lockchan_media_t *m) {
+    if (f->type == LOCKCHAN_TYPE_CLEAR) {
+        if (f->len != 0) return false;
+        *m = (lockchan_media_t){.type = LOCKCHAN_TYPE_CLEAR};
+        return true;
+    }
+    if (f->type != LOCKCHAN_TYPE_NOW_PLAYING) return false;
+    if (f->len < 2 || f->len > 2 + LOCKCHAN_MEDIA_MAX_L0 + LOCKCHAN_MEDIA_MAX_L1) return false;
+    uint8_t icon = f->payload[0], n0 = f->payload[1];
+    if (icon > 3) return false;                         /* bit 7 (playback) included */
+    if (n0 > LOCKCHAN_MEDIA_MAX_L0 || n0 > f->len - 2) return false;
+    uint8_t n1 = (uint8_t)(f->len - 2 - n0);
+    if (n1 > LOCKCHAN_MEDIA_MAX_L1) return false;
+    if (!printable(&f->payload[2], (uint8_t)(n0 + n1))) return false;
+    *m = (lockchan_media_t){
+        .type = LOCKCHAN_TYPE_NOW_PLAYING,
+        .icon = icon,
+        .n0   = n0,
+        .n1   = n1,
+        .l0   = &f->payload[2],
+        .l1   = &f->payload[2 + n0],
+    };
+    return true;
+}
diff --git a/keyboards/a_jazz/ak820pro/lockchan_media.h b/keyboards/a_jazz/ak820pro/lockchan_media.h
new file mode 100644
index 00000000..301d0894
--- /dev/null
+++ b/keyboards/a_jazz/ak820pro/lockchan_media.h
@@ -0,0 +1,35 @@
+// Copyright 2026 JD Lien
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "lockchan.h"
+
+/* What a committed lock-LED frame means (plans/LOCK-LED-CHANNEL-PLAN.md,
+ * R2-9, version 0's types, frozen for the first release):
+ *
+ *   type 1, now playing: [icon][n0][line 0: n0 bytes][line 1: the rest]
+ *     2 <= len <= 42; n0 <= 19, n0 <= len - 2, line 1 = len - 2 - n0 <= 21;
+ *     icon exactly 0-3 (any other bit, the reserved playback bit 7 included,
+ *     rejects); every text byte printable ASCII 0x20-0x7E.
+ *   type 2, clear: exactly zero bytes.
+ *
+ * Anything else is rejected whole. Pure logic, as lockchan.c is: the board
+ * applies a parsed frame (ch582f_ajazz.c), the host tests parse it. */
+
+#define LOCKCHAN_TYPE_NOW_PLAYING 1
+#define LOCKCHAN_TYPE_CLEAR       2
+#define LOCKCHAN_MEDIA_MAX_L0     19
+#define LOCKCHAN_MEDIA_MAX_L1     21
+
+typedef struct {
+    uint8_t        type;          /* LOCKCHAN_TYPE_* */
+    uint8_t        icon;          /* type 1 */
+    uint8_t        n0, n1;        /* type 1: the lines' lengths, either may be 0 */
+    const uint8_t *l0, *l1;       /* into the frame's payload */
+} lockchan_media_t;
+
+/* True, with *m filled, when the frame is a valid type 1 or 2. On false, *m
+ * is untouched and nothing may be applied. */
+bool lockchan_media_parse(const lockchan_frame_t *f, lockchan_media_t *m);
