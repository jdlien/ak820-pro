<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jdlien.ak820pro.clocksync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jdlien/code/ak820-pro/hostagent/ak820-clocksync.sh</string>
    </array>

    <!-- Every 3 hours. At ~58 ppm (~5 s/day) that bounds the error to ~0.63 s,
         well inside the firmware's 2 s snap threshold so the display never
         visibly jumps.
         WHY NOT 6 h: 6 h bounds it to 1.25 s, which is inside the threshold but
         has ZERO margin -- and this sync is --no-wait fire-and-forget that needs
         the cable, so MISSES ARE SILENT AND EXPECTED. One missed sync at 6 h is
         12 h is 2.51 s, over threshold, and the display jumps: exactly the thing
         the deadband exists to prevent. 3 h survives two consecutive misses. -->
    <key>StartInterval</key>
    <integer>10800</integer>

    <!-- Also run at login, so an unplugged-overnight board is corrected as soon
         as the machine is back. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jdlien/Library/Logs/ak820pro-clocksync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jdlien/Library/Logs/ak820pro-clocksync.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
